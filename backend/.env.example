UPLOAD_RAW_DIR=uploads/raw
UPLOAD_PARSED_DIR=uploads/parsed
MAX_FILE_SIZE_MB=20
CORS_ORIGINS=http://localhost:3000
DOCUMENT_TTL_DAYS=30

# AI synthesis (Phase D). OPENAI_API_KEY is optional: when unset the analysis
# pipeline falls back to deterministic narrative generation.
OPENAI_API_KEY=
ANALYSIS_INTERPRETATION_MODEL=gpt-4o-mini
ANALYSIS_SYNTHESIS_MODEL=gpt-4o-mini
ANALYSIS_AI_TIMEOUT=30
